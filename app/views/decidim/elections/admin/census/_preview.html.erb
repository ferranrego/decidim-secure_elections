<%#
  Override of upstream `decidim-elections/app/views/decidim/elections/admin/census/_preview.html.erb`.

  Only delta: swaps the census-size caption for a Vocdoni-scoped copy when
  the election's census manifest is `:vocdoni_secure`. The upstream caption
  ends with "(this might change on a dynamic census)", which is honest for
  `:internal_users` — new authorizations count until the last minute —
  and wrong for us: at publish the Vocdoni SaaS anchors the census on
  chain, and no member added after that will be accepted by the sequencer.

  Rendered from two places: the Census tab (`admin/census/edit.html.erb`)
  and the pre-publish Dashboard (via `admin/dashboard/_census.html.erb`).
  Both go through this partial, so the branch here covers both.
%>
<div class="table-scroll">
  <table class="table-list">
    <thead>
    <tr>
      <th><%= t("edit.identifier", scope: "decidim.elections.admin.census") %></th>
      <th><%= t("edit.created_at", scope: "decidim.elections.admin.census") %></th>
    </tr>
    </thead>
    <tbody>
    <% preview_users(election).each do |voter| %>
      <tr>
        <td><%= voter.identifier %></td>
        <td><%= voter.date_created %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <p class="mt-4 text-gray-2 text-sm">
    <%
      size_key = if election.census_manifest.to_s == "vocdoni_secure"
                   "decidim.elections.censuses.vocdoni_secure.census_size_html"
                 else
                   "decidim.elections.censuses.census_size_html"
                 end
    %>
    <%= t(size_key, count: census_count(election)) %>
  </p>
  <p class="text-gray-2 text-sm">
    <%= t("decidim.elections.admin.census.preview.title", count: 5) %>
  </p>
</div>
