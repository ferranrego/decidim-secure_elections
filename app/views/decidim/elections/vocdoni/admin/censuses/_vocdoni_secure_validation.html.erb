<%#
  Renders the outcome of the last census pre-flight against Vocdoni's SaaS.

  Populated by PushElectionJob.preview_census! via AfterUpdateCensus,
  and by the full PushElectionJob when a real publish fails at the
  same step. Two shapes:

    ok:true  → members push + group create + validate all passed.
                Includes `size:` (roster count) so the admin sees exactly
                how many voters the on-chain census will hold.

    ok:false → validation refused the current auth-field combination, OR
                an earlier prep step blew up (empty roster, memberbase
                push rejected, group create). We only show counts under
                each of `duplicates`, `missingData` and `notFound` — the
                individual ids the SaaS returns are its own memberbase
                hashes and mean nothing to the admin, whose only lever is
                "which fields do I authenticate on".

  Locals: `validation` — the `metadata["census_validation"]` hash.
%>
<%
  data = validation["data"].to_h
  dup_count = Array(data["duplicates"]).size
  missing_count = Array(data["missingData"]).size
  not_found_count = Array(data["notFound"]).size
  has_counts = (dup_count + missing_count + not_found_count).positive?
%>
<% if validation["ok"] %>
  <div class="callout success" role="status">
    <p class="font-semibold">
      <%= t("decidim.elections.censuses.vocdoni_secure.validation.ok_title", count: validation["size"].to_i) %>
    </p>
    <p class="text-sm">
      <%= t("decidim.elections.censuses.vocdoni_secure.validation.ok_body") %>
    </p>
  </div>
<% else %>
  <div class="callout alert" role="status">
    <p class="font-semibold">
      <%= t("decidim.elections.censuses.vocdoni_secure.validation.error_title") %>
    </p>
    <% if has_counts %>
      <ul class="text-sm mt-2 pl-4 list-disc">
        <% if missing_count.positive? %>
          <li><%= t("decidim.elections.censuses.vocdoni_secure.validation.missing_data", count: missing_count) %></li>
        <% end %>
        <% if dup_count.positive? %>
          <li><%= t("decidim.elections.censuses.vocdoni_secure.validation.duplicates", count: dup_count) %></li>
        <% end %>
        <% if not_found_count.positive? %>
          <li><%= t("decidim.elections.censuses.vocdoni_secure.validation.not_found", count: not_found_count) %></li>
        <% end %>
      </ul>
    <% elsif validation["message"].present? %>
      <%# No structured counts — SaaS crashed in a way that did not carry
          `data`, or an earlier step failed (empty roster, memberbase push).
          Fall back to the raw message so the admin sees *something*. %>
      <p class="text-sm mt-1"><%= validation["message"] %></p>
    <% end %>
  </div>
<% end %>
