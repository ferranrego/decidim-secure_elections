<%#
  Rendered inside the upstream Census tab (via `manifest.admin_form_partial`)
  for a `:vocdoni_secure` election.

  Two sections:
   1. The credential-field checkboxes — the identity fields a voter types
      at CSP auth time (all become entries in `authFields` in the SaaS
      payload). Second-factor OTP selection is on its own Security tab and
      is written to `census_settings["twofa_fields"]` from there.
   2. The census pre-flight result — populated by `AfterUpdateCensus`, which
      runs `PublishToVocdoniJob.preview_census!` on save. `ok:true` unblocks
      the Publish button on the Dashboard; anything else keeps it disabled
      until the admin re-picks a combination the roster can satisfy.
%>
<div class="row column font-semibold pb-4">
  <%= t("decidim.elections.censuses.vocdoni_secure.credentials_title") %>
</div>
<div class="row column">
  <p class="mb-2"><%= t("decidim.elections.censuses.vocdoni_secure.credentials_info") %></p>
</div>
<div class="mt-4 form__wrapper gap-1">
  <% Decidim::Elections::Vocdoni::AdminForms::CensusForm::CREDENTIAL_FIELDS.each do |field| %>
    <div class="row">
      <%= label_tag "census_credential_fields_#{field}" do %>
        <%= check_box_tag "census[credential_fields][#{field}]", "1", @form.credential_field?(field), id: "census_credential_fields_#{field}" %>
        <%= t("decidim.elections.censuses.vocdoni_secure.credential_fields.#{field}") %>
      <% end %>
    </div>
  <% end %>
</div>

<%
  vp = election.vocdoni_process
  validation = vp&.census_validation
%>
<% if validation.present? %>
  <div class="mt-6">
    <%= render partial: "decidim/elections/vocdoni/admin/censuses/vocdoni_secure_validation",
               locals: { validation: validation } %>
  </div>
<% end %>
