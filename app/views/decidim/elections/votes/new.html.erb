<%#
  Voter-side entry to the ballot. Overrides upstream
  `decidim-elections/app/views/decidim/elections/votes/new.html.erb`.

  Vocdoni-backed elections (Security tab opt-in → sidecar present) skip
  Decidim's in-page ballot form entirely and hand the voter off to the
  Vocdoni booth SPA, which auths against the CSP, signs the ballot with
  a zk-SNARK and submits it on chain. The Decidim server never sees a
  ballot in this flow.

  Every other election falls back to upstream's own render path — the
  in-page form composed from the current census manifest's
  `voter_form_partial`.
%>
<% if election.vocdoni_process.present? %>
  <%= render "decidim/elections/vocdoni/booth/launcher", election: election %>
<% else %>
  <%= decidim_form_for(@form, url: url_for(action: :create), html: { class: "form form-defaults" }) do |f| %>
    <div class="form__wrapper">
      <div class="flex justify-center">
        <h1 class="title-decorator my-12">
          <%= t("form_title", scope: "decidim.elections.votes.check_census") %>
        </h1>
      </div>

      <%= render partial: election.census.voter_form_partial, locals: { form: f } %>
    </div>
  <% end %>
<% end %>
